{
  "openapi": "3.1.0",
  "info": {
    "title": "VortexRoute Smart Order Router API",
    "description": "GF-T3-154 High-Frequency Convex Liquidity Routing Engine",
    "version": "1.5.4-T3"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/route": {
      "post": {
        "tags": [
          "Routing"
        ],
        "summary": "Optimize Route",
        "operationId": "optimize_route_api_v1_route_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/telemetry": {
      "get": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Get Telemetry",
        "operationId": "get_telemetry_api_v1_telemetry_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderRouteRequest": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "default": "BTC-USDT"
          },
          "side": {
            "type": "string",
            "title": "Side",
            "default": "buy"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity",
            "default": 1.5
          },
          "urgency": {
            "type": "number",
            "title": "Urgency",
            "default": 0.5
          }
        },
        "type": "object",
        "title": "OrderRouteRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}