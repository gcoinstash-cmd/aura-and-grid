rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User Profiles
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.role is string && (data.role == 'client' || data.role == 'broker')
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt;
    }

    // 2. Properties
    function isValidProperty(data) {
      return data.title is string && data.title.size() <= 128
        && data.description is string && data.description.size() <= 2000
        && (data.price is int || data.price is float) && data.price >= 0
        && data.location is string && data.location.size() <= 256
        && data.bedrooms is int && data.bedrooms >= 0
        && (data.bathrooms is int || data.bathrooms is float) && data.bathrooms >= 0
        && (data.sqft is int || data.sqft is float) && data.sqft >= 0
        && data.images is list && data.images.size() <= 10
        && data.status is string && (data.status == 'available' || data.status == 'pending' || data.status == 'sold')
        && data.amenities is list && data.amenities.size() <= 20
        && data.brokerId is string && data.brokerId.size() <= 128
        && data.createdAt is timestamp;
    }

    match /properties/{propertyId} {
      allow read: if true; // Public marketplace
      allow create: if isVerified()
        && isValidId(propertyId)
        && getUserRole() == 'broker'
        && isValidProperty(incoming())
        && incoming().brokerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && isValidId(propertyId)
        && getUserRole() == 'broker'
        && isValidProperty(incoming())
        && incoming().brokerId == existing().brokerId
        && existing().brokerId == request.auth.uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified()
        && isValidId(propertyId)
        && getUserRole() == 'broker'
        && existing().brokerId == request.auth.uid;
    }

    // 3. Inquiries
    function isValidInquiry(data) {
      return data.propertyId is string && data.propertyId.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 128
        && data.senderEmail is string && data.senderEmail.size() <= 128
        && data.message is string && data.message.size() <= 2000
        && data.status is string && (data.status == 'new' || data.status == 'in_progress' || data.status == 'contacted' || data.status == 'closed')
        && data.brokerId is string && data.brokerId.size() <= 128
        && data.createdAt is timestamp;
    }

    match /inquiries/{inquiryId} {
      allow get: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.brokerId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.brokerId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && isValidId(inquiryId)
        && isValidInquiry(incoming())
        && (incoming().senderId == existing().senderId || incoming().brokerId == existing().brokerId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified()
        && (existing().senderId == request.auth.uid || existing().brokerId == request.auth.uid);
    }

    // 4. Maintenance Requests
    function isValidMaintenanceRequest(data) {
      return data.propertyId is string && data.propertyId.size() <= 128
        && data.tenantId is string && data.tenantId.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.description is string && data.description.size() <= 2000
        && data.urgency is string && (data.urgency == 'low' || data.urgency == 'medium' || data.urgency == 'high' || data.urgency == 'emergency')
        && data.status is string && (data.status == 'pending' || data.status == 'scheduled' || data.status == 'completed')
        && data.brokerId is string && data.brokerId.size() <= 128
        && data.createdAt is timestamp;
    }

    match /maintenanceRequests/{requestId} {
      allow get: if isSignedIn()
        && (resource.data.tenantId == request.auth.uid || resource.data.brokerId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.tenantId == request.auth.uid || resource.data.brokerId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(requestId)
        && isValidMaintenanceRequest(incoming())
        && incoming().tenantId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && isValidId(requestId)
        && isValidMaintenanceRequest(incoming())
        && (incoming().tenantId == existing().tenantId || incoming().brokerId == existing().brokerId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified()
        && (existing().tenantId == request.auth.uid || existing().brokerId == request.auth.uid);
    }

    // 5. Appointments
    function isValidAppointment(data) {
      return data.propertyId is string && data.propertyId.size() <= 128
        && data.clientId is string && data.clientId.size() <= 128
        && data.clientName is string && data.clientName.size() <= 128
        && data.clientEmail is string && data.clientEmail.size() <= 128
        && data.brokerId is string && data.brokerId.size() <= 128
        && data.datetime is timestamp
        && data.status is string && (data.status == 'requested' || data.status == 'confirmed' || data.status == 'cancelled')
        && data.createdAt is timestamp;
    }

    match /appointments/{appointmentId} {
      allow get: if isSignedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.brokerId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.brokerId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().clientId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && isValidId(appointmentId)
        && isValidAppointment(incoming())
        && (incoming().clientId == existing().clientId || incoming().brokerId == existing().brokerId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified()
        && (existing().clientId == request.auth.uid || existing().brokerId == request.auth.uid);
    }

    // 6. Private Documents
    function isValidDocument(data) {
      return data.title is string && data.title.size() <= 256
        && data.fileUrl is string && data.fileUrl.size() <= 1024
        && data.clientId is string && data.clientId.size() <= 128
        && data.brokerId is string && data.brokerId.size() <= 128
        && data.uploadedBy is string && data.uploadedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    match /documents/{documentId} {
      allow get: if isSignedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.brokerId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.brokerId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(documentId)
        && isValidDocument(incoming())
        && (incoming().uploadedBy == request.auth.uid)
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && isValidId(documentId)
        && isValidDocument(incoming())
        && (incoming().clientId == existing().clientId || incoming().brokerId == existing().brokerId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified()
        && (existing().clientId == request.auth.uid || existing().brokerId == request.auth.uid || existing().uploadedBy == request.auth.uid);
    }
  }
}
