# =========================================================================
#            OMAKASE & COUNTER - ENVIROMENT CONSTANTS (.env.example)
# =========================================================================
# Setup guide to customize static and transaction integrations:
# Duplicate this file as '.env' in your local copy before booting:
# $ cp .env.example .env

# --- RESERVATION TRANSMISSION APIS (FORM HANDLING) ---
# Set to 'formspree', 'web3forms' or your custom booking backend URL:
VITE_RESERVATION_API_ENDPOINT=https://api.web3forms.com/submit

# If using Web3Forms, declare your public form access token key here:
# (Safe to expose client-side since access keys can only transmit mails)
VITE_WEB3FORMS_ACCESS_KEY=your_public_token_here

# --- SERVER-SIDE SECRETS (NEVER EXPOSE IN CLIENT FILES) ---
# If you build a customized express backend to automate inventory checking,
# define any high-security database keys or private emails below:
# WARNING: Do NOT prefix server variables with 'VITE_', otherwise Vite bundling 
# will extract and expose them in the browser build!
RESERVATION_SMTP_HOST=smtp.mailgun.org
RESERVATION_SMTP_PASSWORD=your_secure_server_smtp_password_here
RESERVATION_DATABASE_SECRET=your_direct_cloud_db_key_here
