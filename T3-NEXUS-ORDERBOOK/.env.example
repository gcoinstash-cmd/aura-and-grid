# T3-NEXUS-ORDERBOOK environment template. Contains NO real secrets.
# Copy to .env and replace every CHANGE_ME value before use. Never commit .env.

# --- Service ---
PORT=8080                 # HTTP listen port (Cloud Run injects PORT)
APP_ENV=development       # development | production
TICK_INTERVAL_MS=100      # WebSocket market-depth aggregation heartbeat (ms)
SYMBOLS=BTC-USDT,ETH-USDT # Comma-separated instruments the engine lists at startup

# --- docker-compose only (local development database/cache) ---
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nexus_db
DATABASE_URL=postgresql://nexus_admin:CHANGE_ME@postgres:5432/nexus_db   # reserved: not yet used by src/
REDIS_URL=redis://redis:6379/0                                          # reserved: not yet used by src/

# --- deploy_cloud_run.sh ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
